# ---- OS / editor noise ----
.DS_Store
._*
Thumbs.db

# ---- Secrets and local state (never commit) ----
.env
*.env.local
prompt.env
database.db
instance/
*.sqlite3

# ---- Python ----
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Virtualenvs and package-manager caches ----
venv/
.venv/
env/
.uvcache/
.uv-cache/
.piptarget/
.uv/

# ---- Scratch directories used during development ----
.tmp/
.tmp2/
.local-notes/

# ---- Cached data exports (regenerated by the app) ----
data/*
!/data/.gitkeep
/data
/data/*
data/orders.csv

# ---- Large third-party binaries kept out of the repo ----
wordpress_plugins/*.zip

# ---- Local generated prompts (contain large source dumps) ----
prompt.txt
prompt_helper.txt

# ---- Explicitly KEEP the storefront dataset ----
# app/shop/dataset/products.json and orders.json are the committed catalog:
# they are small, deterministic, and required for the store to boot.
!app/shop/dataset/
!app/shop/dataset/*.json
